# Copy to .env for local development. Leave values empty here.
# In Azure, services authenticate with managed identity and read any
# remaining secrets from Key Vault; nothing below is used in production.

AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_KEY_VAULT_URI=

AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=

AZURE_STORAGE_ACCOUNT=
AZURE_SEARCH_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
